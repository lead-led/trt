{
	"name": "trt",
	"version": "1.0.0",
	"private": true,
	"description": "Total Remaining Time.",
	"main": "src/electron.cjs",
	"type": "module",
	"author": "Devon Lamond",
	"scripts": {
		"dev": "cross-env NODE_ENV=dev npm run dev:all",
		"dev:all": "concurrently -n=svelte,electron -c='#ff3e00',blue \"npm run dev:svelte\" \"npm run dev:electron\"",
		"dev:svelte": "vite dev",
		"dev:electron": "electron src/electron.cjs",
		"build": "npm run patch cross-env NODE_ENV=production npm run build:svelte && npm run build:electron",
		"build:svelte": "vite build",
		"build:electron": "electron-builder -w --config electron-builder.json",
		"publish": "electron-builder --config electron-builder.json --publish always -mwl",
		"release": "electron-builder --config electron-builder.json --publish always -mwl",
		"major": "node version/major",
		"minor": "node version/minor",
		"patch": "node version/patch"
	},
	"engines": {
		"npm": ">=7",
		"yarn": "use npm - https://github.com/FractalHQ/sveltekit-electron/issues/12#issuecomment-1068399385"
	},
	"browserslist": [
		"Chrome 89"
	],
	"dependencies": {
		"@fontsource/overpass": "^5.0.3",
		"@neodrag/svelte": "^2.0.3",
		"address": "^1.2.2",
		"app-builder-lib": "^24.5.0",
		"electron-context-menu": "^3.6.1",
		"electron-log": "^4.4.8",
		"electron-reloader": "^1.2.3",
		"electron-serve": "^1.1.0",
		"electron-store": "^8.1.0",
		"electron-updater": "^5.3.0",
		"electron-window-state": "^5.0.3",
		"express": "^4.18.2",
		"ip": "^1.1.8",
		"nanoid": "^5.0.9",
		"osc": "^2.4.4",
		"svelte-dnd-action": "^0.9.38"
	},
	"devDependencies": {
		"@iconify/json": "^2.2.103",
		"@sveltejs/adapter-static": "^3.0.0",
		"@sveltejs/kit": "^2.0.0",
		"@typescript-eslint/eslint-plugin": "^5.56.0",
		"@typescript-eslint/parser": "^5.56.0",
		"carbon-components-svelte": "^0.78.0",
		"concurrently": "^7.6.0",
		"cross-env": "^7.0.3",
		"dotenv": "^16.0.3",
		"electron": "^35.7.5",
		"electron-builder": "^24.4.0",
		"electron-connect": "^0.6.3",
		"electron-packager": "^17.1.1",
		"eslint": "^8.36.0",
		"eslint-config-prettier": "^8.8.0",
		"eslint-plugin-svelte": "^2.44.0",
		"npm-run-all": "^4.1.5",
		"prettier": "^3.0.0",
		"prettier-plugin-svelte": "^3.0.0",
		"sass": "^1.60.0",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"tslib": "^2.5.0",
		"typescript": "^5.7.0",
		"unplugin-icons": "^0.16.5",
		"vite": "^6.3.0"
	},
	"overrides": {
		"electron": {
			"got": "^12.5.1"
		}
	}
}
